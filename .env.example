# StudyMate ICT — environment variables
#
# Copy to .env for local use (`cp .env.example .env`) and fill in the values.
# .env is git-ignored. On Render, set these in the service's Environment tab
# (or via the `sync: false` entries in render.yaml). Never commit real keys.
#
# With no AI_API_KEY the app still runs: every tool works, the AI buttons are
# disabled and the UI says "prompt mode". That is the intended fallback.

# --- Required to enable live AI -------------------------------------------
# Server-side API key for an OpenAI-compatible provider. The browser never
# sees this value: it is used only by the server process.
AI_API_KEY=

# --- Provider (all optional) ----------------------------------------------
# Any endpoint that implements POST {base}/chat/completions.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Label shown in the UI status chip.
AI_PROVIDER=OpenAI-compatible
# Some providers reject response_format; set to "off" for those.
AI_JSON_MODE=on

# --- Limits (all optional) ------------------------------------------------
# Per-instance, in-memory limits. They reset when the service restarts and are
# enforced separately on each instance — see LIMITATIONS_AND_FUTURE_WORK.md.
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT=20
AI_RATE_WINDOW_MS=600000
AI_DAILY_CAP=300

# --- Server --------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Directory that holds the built app (build.sh writes dist/).
SERVE_DIR=dist
# Extra origins allowed to call POST /api/ai (comma separated). Same-origin is
# always allowed. Leave empty for a single-origin deployment.
AI_ALLOWED_ORIGINS=
